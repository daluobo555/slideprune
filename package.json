{
  "name": "slideprune",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Turn repetitive slide PDFs into a reviewable study handout, locally in your browser.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "test:package": "node --test scripts/package-windows.test.mjs",
    "test:windows": "node tools/windows/launcher.test.mjs",
    "package:windows": "npm run build && node scripts/package-windows.mjs"
  },
  "dependencies": {
    "docx": "9.8.1",
    "fflate": "0.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
